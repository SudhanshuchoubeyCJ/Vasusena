# Copy to .env and fill in. Never commit .env.
PORT=8080

# Free LLM for smarter follow-up questions: set ONE of these (both have free tiers):
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: override the model name if the default is retired
LLM_MODEL=

# Owner review page (#admin). Use a long random string, e.g. output of: openssl rand -hex 24
ADMIN_TOKEN=

# Test mode only: lets anyone switch on Pro for free. Keep this line for local testing,
# and do NOT set it on your public site until real payments are connected.
ALLOW_DEMO_PRO=true
